{
  "schemaVersion": 1,
  "id": "ray",
  "version": "${version}",
  "name": "Ray Client",
  "description": "A clean, legit client in the style of Lunar, Badlion and Dawn: a searchable module menu, HUD, zoom, block outline, custom crosshair, and a branded title and loading screen.",
  "authors": [
    "Ray"
  ],
  "license": "MIT",
  "environment": "client",
  "mixins": [
    "ray.mixins.json",
    "ray.compat.mixins.json"
  ],
  "entrypoints": {
    "client": [
      "dev.ray.RayClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.11",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  },
  "icon": "assets/ray/icon.png",
  "custom": {
    "ray": {
      "minecraft": "${minecraft_version}"
    }
  }
}
